<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules (API 31+). Same exclusion as
     backup_rules.xml, for both cloud backup and device-to-device
     transfer: the app-lock secure store never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sentinel_academy_secure_store.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sentinel_academy_secure_store.xml" />
    </device-transfer>
</data-extraction-rules>
